# AI Orchestrator — variáveis de ambiente (nomes apenas; nunca comite valores reais)
# Copie para .env na raiz do projeto e preencha somente as chaves dos providers que você usa.

# Provider keys
NVIDIA_API_KEY=
LLM7_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=
CHUTES_API_KEY=
MULEROUTER_API_KEY=
CEREBRAS_API_KEY=
OPENCODE_API_KEY=

# Runtime
APP_HOST=127.0.0.1
APP_PORT=3000
DEFAULT_PROVIDER=nvidia
PREFER_FREE_PROVIDERS=true

# Orquestração
MAX_RETRIES_PER_PROVIDER=2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=30000
MAX_CONTEXT_CHARS=90000
MAX_MULTI_AGENTS=5
MAX_HIVE_AGENTS=7
MAX_DEBUG_ATTEMPTS=3
REQUEST_TIMEOUT_MS=120000

# Ferramentas (workspace)
WORKSPACE_ROOT=
TOOLS_ALLOW_WRITE=true
TOOLS_ALLOW_EXECUTE=true
TOOLS_ALLOW_DELETE=false
TOOLS_ALLOW_NETWORK=true
